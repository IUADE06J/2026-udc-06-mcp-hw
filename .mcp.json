{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "${CLAUDE_PROJECT_DIR:-.}/app/data"
      ]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@2026.7.4"],
      "env": {
        "MEMORY_FILE_PATH": "${CLAUDE_PROJECT_DIR:-.}/.mcp-memory.json"
      }
    },
    "catalog": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/mcp-server/dist/server.js"]
    }
  }
}
